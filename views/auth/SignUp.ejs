<%- include('../partials/head') %>
  </head>

  <body class="bg-gradient-to-br from-purple-600 via-blue-600 to-indigo-700 min-h-screen text-white relative">

    <%- include('../partials/navbar') %>

      <!-- Animated background -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <div class="absolute top-32 left-10 w-20 h-20 bg-white opacity-10 rounded-full animate-bounce"></div>
        <div class="absolute top-48 right-20 w-16 h-16 bg-white opacity-15 rounded-full animate-pulse"></div>
        <div class="absolute bottom-40 left-20 w-24 h-24 bg-white opacity-10 rounded-full animate-bounce delay-1000">
        </div>
        <div class="absolute bottom-56 right-10 w-12 h-12 bg-white opacity-15 rounded-full animate-pulse delay-2000">
        </div>
        <div class="absolute top-1/2 left-1/4 w-8 h-8 bg-white opacity-10 rounded-full animate-pulse delay-500"></div>
        <div class="absolute top-3/4 right-1/3 w-14 h-14 bg-white opacity-10 rounded-full animate-bounce delay-1500">
        </div>
      </div>

      <!-- Signup Form -->
      <main class="bg-gradient-to-br from-purple-600 to-blue-600 min-h-screen text-white flex flex-col">

        <!-- Space for fixed navbar -->
        <div class="h-16"></div>

        <!-- Centered form container -->
        <div class="flex-grow flex items-center justify-center px-4 py-8">
          <div class="bg-white bg-opacity-10 backdrop-blur-md rounded-2xl shadow-lg w-full max-w-md p-8 text-center">

            <!-- Icon -->
            <div
              class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M18 20H6a2 2 0 01-2-2V6a2 2 0 012-2h7l5 5v9a2 2 0 01-2 2z" />
              </svg>
            </div>

            <!-- Heading -->
            <h2 class="text-2xl font-bold mb-1">Create Account</h2>
            <p class="text-sm mb-6  text-red-300 hover:text-red-200 transition duration-300">Join our community today
            </p>



            <!-- SignUp Form -->
            <form action="/signup" method="POST" class="space-y-4 text-left">

              <% if (typeof errorMessage !=='undefined' && errorMessage.length> 0) { %>
                <div
                  class="mb-6 p-5 bg-gradient-to-r from-red-50 to-red-100 border-2 border-red-300 shadow-lg rounded-lg animate-pulse">
                  <!-- Error Header with Icon -->
                  <div class="flex items-center mb-3">
                    <div class="flex-shrink-0">
                      <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                          clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div class="ml-3">
                      <h3 class="text-lg font-semibold text-red-800">
                        Validation Error<%= errorMessage.length> 1 ? 's' : '' %> Occurred
                      </h3>
                    </div>
                  </div>

                  <!-- Error Messages -->
                  <div class="bg-white bg-opacity-70 rounded-md p-4 border-l-4 border-red-400">
                    <ul class="space-y-2">
                      <% errorMessage.forEach(error=> { %>
                        <li class="flex items-start">
                          <span class="flex-shrink-0 w-2 h-2 bg-red-500 rounded-full mt-2 mr-3"></span>
                          <span class="text-red-700 font-medium">
                            <%= error %>
                          </span>
                        </li>
                        <% }) %>
                    </ul>
                  </div>

                  <!-- Close Button (Optional) -->
                  <div class="mt-4 flex justify-end">
                    <button onclick="this.parentElement.parentElement.style.display='none'"
                      class="text-red-600 hover:text-red-800 text-sm font-medium focus:outline-none">
                      Dismiss
                    </button>
                  </div>
                </div>
                <% } %>

                  <!-- ...existing code... -->

                  <!-- ...existing code... -->

                  <!-- First Name -->
                  <div class="relative mb-6">
                    <label for="firstName" class="block text-sm font-bold text-gray-200 mb-2 ml-2 text-left">First
                      Name</label>
                    <span class="absolute left-4 mt-6 text-gray-800 transform -translate-y-1/2 ">
                      <!-- User Icon -->
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 20v-1a8 8 0 0116 0v1" />
                      </svg>
                    </span>
                    <input type="text" name="firstName"
                      value="<%= typeof oldInput !== 'undefined' ? oldInput.firstName : '' %>" placeholder="First Name"
                      class="w-full pl-12 pr-4 py-3 rounded-lg bg-white text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-300 shadow"
                      required>
                  </div>

                  <!-- Last Name -->
                  <div class="relative mb-6">
                    <label for="lastName" class="block text-sm font-bold text-gray-200 mb-2 ml-2 text-left">Last
                      Name</label>
                    <span class="absolute left-4 mt-6 text-gray-800 transform -translate-y-1/2">
                      <!-- User Tie Icon -->
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M12 12v8m0 0l-3-4m3 4l3-4" />
                      </svg>
                    </span>
                    <input type="text" name="lastName"
                      value="<%= typeof oldInput !== 'undefined' ? oldInput.lastName : '' %>" placeholder="Last Name"
                      class="w-full pl-12 pr-4 py-3 rounded-lg bg-white text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-300 shadow">
                  </div>

                  <!-- Email -->
                  <div class="relative mb-6">
                    <label for="email" class="block text-sm font-bold text-gray-200 mb-2 ml-2 text-left">Email
                      Address</label>
                    <span class="absolute left-4 mt-6 text-gray-800 transform -translate-y-1/2 ">
                      <!-- Envelope Icon -->
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="3" y="7" width="18" height="10" rx="2" />
                        <path d="M3 7l9 6 9-6" />
                      </svg>
                    </span>
                    <input type="email" name="email"
                      value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>" placeholder="Email"
                      class="w-full pl-12 pr-4 py-3 rounded-lg bg-white text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-300 shadow"
                      required>
                  </div>

                  <!-- Password -->
                  <div class="relative mb-6">
                    <label for="password"
                      class="block text-sm font-bold text-gray-200 mb-2 ml-2 text-left">Password</label>
                    <span class="absolute left-4 mt-6 text-gray-800 transform -translate-y-1/2">
                      <!-- Lock Icon -->
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="5" y="11" width="14" height="10" rx="2" />
                        <path d="M12 16v2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                      </svg>
                    </span>
                    <input type="password" name="password" placeholder="Password"
                      class="w-full pl-12 pr-4 py-3 rounded-lg bg-white text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-300 shadow"
                      required>
                  </div>

                  <!-- Confirm Password -->
                  <div class="relative mb-6">
                    <label for="confirmPassword"
                      class="block text-sm font-bold text-gray-200 mb-2 ml-2 text-left">Confirm Password</label>
                    <span class="absolute left-4 mt-6 text-gray-800 transform -translate-y-1/2">
                      <!-- Lock Icon -->
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="5" y="11" width="14" height="10" rx="2" />
                        <path d="M12 16v2" />
                        <path d="M7 11V7a5 5 0 0110 0v4" />
                      </svg>
                    </span>
                    <input type="password" name="confirmPassword" placeholder="Confirm Password"
                      class="w-full pl-12 pr-4 py-3 rounded-lg bg-white text-black placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-300 shadow"
                      required>
                  </div>

                  <!-- User Type Dropdown -->
                  <div class="relative mb-6">
                    <label for="userType" class="block text-sm font-bold text-gray-200 mb-2 ml-2 text-left">User
                      Type</label>
                    <span class="absolute left-4 mt-6 text-gray-800 transform -translate-y-1/2">
                      <!-- Users Icon -->
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="9" cy="7" r="4" />
                        <circle cx="17" cy="7" r="4" />
                        <path d="M2 20v-1a7 7 0 0114 0v1" />
                        <path d="M10 20v-1a7 7 0 0114 0v1" />
                      </svg>
                    </span>
                    <select name="userType"
                      class="w-full pl-12 pr-10 py-3 rounded-lg bg-white text-black appearance-none focus:outline-none focus:ring-2 focus:ring-blue-300 shadow"
                      required>
                      <option value="" disabled <%=typeof oldInput==='undefined' || !oldInput.userType ? 'selected' : ''
                        %>>Select User Type</option>
                      <option value="Guest" <%=typeof oldInput !=='undefined' && oldInput.userType==='Guest'
                        ? 'selected' : '' %>>Guest</option>
                      <option value="Host" <%=typeof oldInput !=='undefined' && oldInput.userType==='Host' ? 'selected'
                        : '' %>>Host</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
                      <svg class="w-4 h-4 mt-6 text-gray-600" fill="none" stroke="currentColor" stroke-width="2"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>

                  <!-- Terms and Conditions -->
                  <label class="flex items-center space-x-2 text-sm text-white mb-6 ml-2">
                    <input type="checkbox" name="terms" class="form-checkbox h-4 w-4 text-blue-500" required>
                    <span>I agree to the <a href="#"
                        class="underline text-red-300 hover:text-red-200 transition duration-300">Terms and
                        Conditions</a></span>
                  </label>

                  <!-- ...existing code... -->

                  <!-- ...existing code... -->

                  <!-- Submit Button -->
                  <button type="submit"
                    class="w-full py-3 bg-red-500 hover:bg-red-600 rounded-lg font-semibold text-white transition">
                    Sign Up
                  </button>
            </form>

            <!-- Login Link -->
            <p class="text-xs text-gray-200 mt-4">Already have an account?
              <a href="/login" class="font-medium text-red-300 hover:text-red-200 transition duration-300">Login now</a>
            </p>
          </div>
        </div>
      </main>
  </body>

  </html>