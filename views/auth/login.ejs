<%- include('../partials/head') %>
  </head>

  <body class="bg-gradient-to-br from-purple-600 to-blue-600 min-h-screen">
    <%- include('../partials/navbar') %>

      <!-- Animated background elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-32 left-10 w-20 h-20 bg-white opacity-10 rounded-full animate-bounce"></div>
        <div class="absolute top-48 right-20 w-16 h-16 bg-white opacity-10 rounded-full animate-pulse"></div>
        <div class="absolute bottom-40 left-20 w-24 h-24 bg-white opacity-10 rounded-full animate-bounce"></div>
        <div class="absolute bottom-56 right-10 w-12 h-12 bg-white opacity-10 rounded-full animate-pulse"></div>
      </div>

      <!-- Main Content -->
      <main class="pt-20 pb-6 min-h-screen flex items-center justify-center px-4">
        <div class="w-full max-w-md">
          <div class="backdrop-blur-lg bg-white/10 border border-white/20 rounded-2xl shadow-2xl p-8">

            <!-- Header -->
            <div class="text-center mb-6">
              <div class="mx-auto w-12 h-12 bg-red-500 rounded-full flex items-center justify-center mb-3 shadow-lg">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-white mb-1">Welcome Back</h2>
              <p class="text-gray-200 text-sm">Login to your account</p>
            </div>

            <!-- Login Form -->
            <form action="/login" method="POST" class="space-y-4">

              <% if (typeof errorMessage !=='undefined' && errorMessage.length> 0) { %>
                <div
                  class="mb-6 p-5 bg-gradient-to-r from-red-50 to-red-100 border-2 border-red-300 shadow-lg rounded-lg animate-pulse">
                  <!-- Error Header with Icon -->
                  <div class="flex items-center mb-3">
                    <div class="flex-shrink-0">
                      <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                          clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <div class="ml-3">
                      <h3 class="text-lg font-semibold text-red-800">
                        Validation Error<%= errorMessage.length> 1 ? 's' : '' %> Occurred
                      </h3>
                    </div>
                  </div>

                  <!-- Error Messages -->
                  <div class="bg-white bg-opacity-70 rounded-md p-4 border-l-4 border-red-400">
                    <ul class="space-y-2">
                      <% errorMessage.forEach(error=> { %>
                        <li class="flex items-start">
                          <span class="flex-shrink-0 w-2 h-2 bg-red-500 rounded-full mt-2 mr-3"></span>
                          <span class="text-red-700 font-medium">
                            <%= error %>
                          </span>
                        </li>
                        <% }) %>
                    </ul>
                  </div>

                  <!-- Close Button (Optional) -->
                  <div class="mt-4 flex justify-end">
                    <button onclick="this.parentElement.parentElement.style.display='none'"
                      class="text-red-600 hover:text-red-800 text-sm font-medium focus:outline-none">
                      Dismiss
                    </button>
                  </div>
                </div>
                <% } %>

                  <!-- ...existing code... -->

                  <!-- Email Field -->
                  <div class="relative">
                    <label for="email" class="block text-sm font-medium text-gray-200 mb-2">Email Address</label>
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <rect x="3" y="7" width="18" height="10" rx="2" />
                          <path d="M3 7l9 6 9-6" />
                        </svg>
                      </div>
                      <input type="email" id="email" name="email"
                        value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>" required
                        placeholder="Email"
                        class="block w-full h-12 pl-10 pr-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent bg-white/90 backdrop-blur-sm text-gray-900 placeholder-gray-500 transition-all duration-300 hover:shadow-lg focus:shadow-lg text-sm">
                    </div>
                  </div>

                  <!-- Password Field -->
                  <div class="relative">
                    <label for="password" class="block text-sm font-medium text-gray-200 mb-2">Password</label>
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
                          viewBox="0 0 24 24">
                          <rect x="5" y="11" width="14" height="10" rx="2" />
                          <path d="M12 16v2" />
                          <path d="M7 11V7a5 5 0 0110 0v4" />
                        </svg>
                      </div>
                      <input type="password" id="password" name="password" required placeholder="Password"
                        class="block w-full h-12 pl-10 pr-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent bg-white/90 backdrop-blur-sm text-gray-900 placeholder-gray-500 transition-all duration-300 hover:shadow-lg focus:shadow-lg text-sm">
                    </div>
                  </div>

                  <!-- ...existing code... -->

                  <!-- Remember Me and Forgot Password -->
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <input id="remember-me" name="remember-me" type="checkbox"
                        class="h-4 w-4 text-red-500 focus:ring-red-500 border-gray-300 rounded">
                      <label for="remember-me" class="ml-2 block text-sm text-gray-200">Remember me</label>
                    </div>
                    <div class="text-sm">
                      <a href="/forgot-password" class="text-red-300 hover:text-red-200 transition duration-300">
                        Forgot your password?
                      </a>
                    </div>
                  </div>

                  <!-- Login Button -->
                  <div>
                    <button type="submit"
                      class="group relative w-full  h-12 flex justify-center py-2.5 px-4 border border-transparent text-sm font-medium rounded-lg text-white bg-red-500 hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-all duration-300 hover:shadow-lg hover:transform hover:-translate-y-1">
                      <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-red-300 group-hover:text-red-200" fill="currentColor"
                          viewBox="0 0 20 20">
                          <path fill-rule="evenodd"
                            d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                            clip-rule="evenodd" />
                        </svg>
                      </span>
                      Login
                    </button>
                  </div>
            </form>

            <!-- Sign Up Link -->
            <div class="mt-4 text-center">
              <p class="text-xs text-gray-200">
                Don't have an account?
                <a href="/SignUp" class="font-medium text-red-300 hover:text-red-200 transition duration-300">
                  Sign up now
                </a>
              </p>
            </div>
          </div>
        </div>
      </main>
  </body>

  </html>