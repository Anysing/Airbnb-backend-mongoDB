<header class="bg-red-500 text-white p-2 fixed top-0 z-10 shadow-md w-full">
  <nav class="container mx-auto flex flex-wrap justify-between items-center">
    <!-- Left-side navigation -->
    <ul class="flex flex-wrap space-x-2 md:space-x-4 items-center">
      <li>
        <a href="/"
          class="<%= currentPage === 'index' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[110px] justify-center">
          <!-- Airbnb Logo -->
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path
              d="M12 2C7.03 2 2.5 6.03 2.5 11c0 4.97 4.53 9 9.5 9s9.5-4.03 9.5-9c0-4.97-4.53-9-9.5-9zm0 16c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z" />
            <circle cx="12" cy="11" r="3" />
          </svg>
          Airbnb
        </a>
      </li>
      <% if(isLoggedIn){ %>
        <li>
          <a href="/Home-list"
            class="<%= currentPage === 'Homes' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[110px] justify-center">
            <!-- Home Icon -->
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 12l9-9 9 9" />
              <path d="M9 21V9h6v12" />
            </svg>
            Home List
          </a>
        </li>
        <li>
          <a href="/favourite"
            class="<%= currentPage === 'favourite' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[110px] justify-center">
            <!-- Heart Icon -->
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path
                d="M12 21C12 21 4 13.5 4 8.5C4 5.42 6.42 3 9.5 3C11.24 3 12.91 4.01 13.44 5.36C13.97 4.01 15.64 3 17.5 3C20.58 3 23 5.42 23 8.5C23 13.5 15.5 21 12 21Z" />
            </svg>
            Favourites
          </a>
        </li>
        <li>
          <a href="/bookings"
            class="<%= currentPage === 'bookings' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[110px] justify-center">
            <!-- Calendar Icon -->
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M16 2v4M8 2v4M3 10h18" />
            </svg>
            Bookings
          </a>
        </li>
        <li>
          <a href="/host/host-homes"
            class="<%= currentPage === 'host-homes' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[110px] justify-center">
            <!-- Host Icon -->
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="4" />
              <path d="M6 20v-2a6 6 0 0112 0v2" />
            </svg>
            Host Homes
          </a>
        </li>
        <li>
          <a href="/host/add-home"
            class="<%= currentPage === 'add-home' ? 'bg-white text-red-500': 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[110px] justify-center">
            <!-- Plus Icon -->
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 5v14M5 12h14" />
            </svg>
            Add Home
          </a>
        </li>
        <% } %>
    </ul>

    <!-- Right-side auth buttons -->
    <ul class="flex flex-wrap space-x-2 md:space-x-4 items-center">
      <% if(isLoggedIn) { %>
        <li>
          <form action="/logout" method="post">
            <button
              class="<%= currentPage === 'login' ? 'bg-white text-red-500': 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[90px] justify-center">
              <!-- Logout Icon -->
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M17 16l4-4m0 0l-4-4m4 4H7" />
                <path d="M3 21V3" />
              </svg>
              Log out
            </button>
          </form>
        </li>
        <% } else { %>
          <li>
            <a href="/SignUp"
              class="<%= currentPage === 'signup' ? 'bg-white text-red-500': 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[90px] justify-center">
              <!-- User Plus Icon -->
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="9" cy="7" r="4" />
                <path d="M17 11v6M20 14h-6" />
              </svg>
              SignUp
            </a>
          </li>
          <li>
            <a href="/login"
              class="<%= currentPage === 'login' ? 'bg-white text-red-500': 'hover:bg-red-400' %> flex items-center py-2 px-3 md:px-4 rounded transition duration-300 min-w-[90px] justify-center">
              <!-- Login Icon -->
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M15 12H3M12 7l-5 5 5 5" />
                <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Login
            </a>
          </li>
          <% } %>
    </ul>
  </nav>
  <!-- Responsive hamburger for mobile -->
  <style>
    @media (max-width: 768px) {
      nav ul {
        flex-direction: column;
        gap: 0.5rem;
      }

      nav ul li {
        width: 100%;
      }

      nav {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    nav ul li a,
    nav ul li button {
      min-width: 90px;
      font-size: 1rem;
      padding-top: 0.5rem !important;
      /* Reduce vertical padding */
      padding-bottom: 0.5rem !important;
    }
  </style>
</header>