<header class="bg-red-500 text-white p-4 fixed top-0 z-10 shadow-md w-full">
  <nav class="container mx-auto flex justify-between items-center">
    <!-- Left-side navigation -->
    <ul class="flex space-x-4">
      <li>
        <a
          href="/"
          class="<%= currentPage === 'index' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Airbnb</a
        >
      </li>

      <% if(isLoggedIn){ %>
      <li>
        <a
          href="/Home-list"
          class="<%= currentPage === 'Homes' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Home List</a
        >
      </li>
      <li>
        <a
          href="/favourite"
          class="<%= currentPage === 'favourite' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Favourites</a
        >
      </li>
      <li>
        <a
          href="/bookings"
          class="<%= currentPage === 'bookings' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Bookings</a
        >
      </li>
      <li>
        <a
          href="/host/host-homes"
          class="<%= currentPage === 'host-homes' ? 'bg-white text-red-500' : 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Host Homes</a
        >
      </li>
      <li>
        <a
          href="/host/add-home"
          class="<%= currentPage === 'add-home' ? 'bg-white text-red-500': 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Add Home</a
        >
      </li>
      <% } %>
    </ul>

    <!-- Right-side auth buttons -->
    <ul class="flex space-x-4">
      <% if(isLoggedIn) { %>
      <li>
        <form action="/logout" method="post">
          <button
            class="<%= currentPage === 'login' ? 'bg-white text-red-500': 'hover:bg-red-400' %> rounded transition duration-300"
          >
            Log out
          </button>
        </form>
      </li>
      <% } else { %>
      <li>
        <a
          href="/SignUp"
          class="<%= currentPage === 'signup' ? 'bg-white text-red-500': 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >SignUp</a
        >
      </li>
      <li>
        <a
          href="/login"
          class="<%= currentPage === 'login' ? 'bg-white text-red-500': 'hover:bg-red-400' %> py-2 px-4 rounded transition duration-300"
          >Login</a
        >
      </li>
      <% } %>
    </ul>
  </nav>
</header>
